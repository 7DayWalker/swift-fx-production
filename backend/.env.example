# SwiftFX Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
MONGO_URL="mongodb://localhost:27017"
DB_NAME="swiftfx_db"

# JWT
JWT_SECRET="your-secure-jwt-secret-here"

# Supabase (Backend - Service Role for admin operations)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# AI Integration (Emergent LLM)
EMERGENT_LLM_KEY=""

# Apple IAP
APPLE_SHARED_SECRET=""
APPLE_BUNDLE_ID="com.yourapp.bundle"
APPLE_ENVIRONMENT="sandbox"
APPLE_KEY_ID=""
APPLE_ISSUER_ID=""
APPLE_PRIVATE_KEY=""
APPLE_WEBHOOK_SECRET=""

# Google IAP
GOOGLE_PACKAGE_NAME="com.yourapp.package"
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_PUBSUB_TOPIC=""
GOOGLE_WEBHOOK_TOKEN=""

# IAP Product IDs
IOS_PREMIUM_MONTHLY_ID="premium_monthly"
IOS_VIP_MONTHLY_ID="vip_monthly"
ANDROID_PREMIUM_MONTHLY_ID="premium_monthly"
ANDROID_VIP_MONTHLY_ID="vip_monthly"

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=""
