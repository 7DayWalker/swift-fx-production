{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "distribution": "store",
      "node": "18"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "workingDirectory": "frontend"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "workingDirectory": "frontend",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "workingDirectory": "frontend"
    }
  },
  "submit": {
    "production": {}
  }
}
