-----+    def test_access_control(self):
-----+        """Test access control between free and premium/VIP users"""
-----+        print(f"\n=== Testing Access Control ===")
-----+        
-----+        # Test with free user
-----+        if self.free_token:
-----+            print(f"\n--- Testing Free User Access ---")
