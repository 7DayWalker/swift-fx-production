-----+                    if data.get('weekly_limit') == 20:
-----+                        print(f"✅ VIP weekly limit correct (20)")
-----+                    else:
-----+                        print(f"❌ VIP weekly limit incorrect: expected 20, got {data.get('weekly_limit')}")
