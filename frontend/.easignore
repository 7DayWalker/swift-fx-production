# EAS Build & Update upload ignore list.
# NOTE: Do NOT put '*' here — .easignore overrides .gitignore for EAS Build tarball uploads!
node_modules/
.expo/
.expo-shared/
.metro-cache/
.metro-health-check*
dump/
*.bson
dist/
web-build/
coverage/
*.tsbuildinfo
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.env.local
.env.*.local
