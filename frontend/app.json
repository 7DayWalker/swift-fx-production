{
  "expo": {
    "name": "Swift FX Signals",
    "slug": "swiftfx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swiftfx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "7daywalker",
    "extra": {
      "eas": {
        "projectId": "55b1cc02-1079-4abd-967a-ff28c1627cd6"
      }
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swiftfx.signals",
      "associatedDomains": [
        "applinks:swiftfx.app",
        "webcredentials:swiftfx.app"
      ],
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["swiftfx"]
          }
        ]
      }
    },
    "android": {
      "package": "com.swiftfx.signals",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "swiftfx.app",
              "pathPrefix": "/register"
            },
            {
              "scheme": "swiftfx",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0A0E17"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
