{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "distribution": "store"
    },

    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_FLUTTERWAVE": "true",
        "EXPO_PUBLIC_DISTRIBUTION_CHANNEL": "android_apk"
      }
    },

    "production": {
      "extends": "base",
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "autoIncrement": "versionCode"
      }
    },

    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENABLE_FLUTTERWAVE": "true",
        "EXPO_PUBLIC_DISTRIBUTION_CHANNEL": "android_apk"
      }
    }
  },

  "submit": {
    "production": {}
  }
}
