{"dependencies":[],"output":[{"data":{"code":"__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {\n  \"use strict\";\n\n  Object.defineProperty(exports, '__esModule', {\n    value: true\n  });\n  Object.defineProperty(exports, \"BEGINNER_COURSES\", {\n    enumerable: true,\n    get: function () {\n      return BEGINNER_COURSES;\n    }\n  });\n  Object.defineProperty(exports, \"INTERMEDIATE_COURSES\", {\n    enumerable: true,\n    get: function () {\n      return INTERMEDIATE_COURSES;\n    }\n  });\n  Object.defineProperty(exports, \"ADVANCED_COURSES\", {\n    enumerable: true,\n    get: function () {\n      return ADVANCED_COURSES;\n    }\n  });\n  Object.defineProperty(exports, \"INTERMEDIATE_COURSE_PREVIEWS\", {\n    enumerable: true,\n    get: function () {\n      return INTERMEDIATE_COURSE_PREVIEWS;\n    }\n  });\n  Object.defineProperty(exports, \"ADVANCED_COURSE_PREVIEWS\", {\n    enumerable: true,\n    get: function () {\n      return ADVANCED_COURSE_PREVIEWS;\n    }\n  });\n  exports.getCourseContent = getCourseContent;\n  exports.getLessonContent = getLessonContent;\n  exports.getCourseCategory = getCourseCategory;\n  // ==============================================================================\n  // SWIFT FX ACADEMY - COMPLETE LESSON CONTENT DATA v3.0\n  // ==============================================================================\n  // \n  // STRUCTURE:\n  // - BEGINNER courses: FREE access (full content)\n  // - INTERMEDIATE courses: PREMIUM access (full content, locked for free users)\n  // - ADVANCED courses: VIP access (full content, locked for free/premium users)\n  // \n  // VIDEO RULES:\n  // - All videos are SHORT (5-8 minutes) and topic-relevant\n  // - youtubeId is the video ID for embedding (not full URL)\n  // ==============================================================================\n\n  // ==============================================================================\n  // BEGINNER COURSES - FREE ACCESS (FULL CONTENT)\n  // ==============================================================================\n\n  const BEGINNER_COURSES = [{\n    id: 'intro-trading',\n    title: 'Introduction to Trading',\n    description: 'Learn the basics of financial markets',\n    category: 'beginner',\n    lessons: [{\n      id: 1,\n      title: 'What is Trading?',\n      duration: '5 min',\n      type: 'video',\n      overview: `Trading is the act of buying and selling financial assets with the goal of making a profit. When you trade, you're essentially trying to predict whether the price of an asset will go up or down.\n\nThink of it like buying and selling items at a market. If you buy something at a low price and sell it at a higher price, you make a profit. The same principle applies to financial trading.\n\nThe beauty of modern trading is that anyone with an internet connection can participate in global markets. You don't need to be a Wall Street professional to start learning.`,\n      keyTakeaways: ['Trading involves buying assets at one price and selling at another', 'The goal is to profit from price movements in financial markets', 'Modern technology allows anyone to access global markets', 'Success requires education, practice, and proper risk management'],\n      youtubeId: 'Xn7KWR9EOGQ',\n      youtubeTitle: 'What is Trading? Beginner Introduction'\n    }, {\n      id: 2,\n      title: 'Types of Financial Markets',\n      duration: '6 min',\n      type: 'video',\n      overview: `There are several major financial markets where trading takes place, each with unique characteristics.\n\nThe Forex market is the largest and most liquid, trading currencies 24 hours a day. The Stock Market lets you buy shares of companies. Commodities markets trade physical goods like gold and oil. Cryptocurrency markets offer 24/7 trading of digital assets.\n\nFor beginners, understanding these markets helps you choose where to focus your learning and trading efforts.`,\n      keyTakeaways: ['Forex is the largest market with $6+ trillion daily volume', 'Stock markets let you own pieces of companies', 'Commodities include gold, oil, and agricultural products', 'Crypto markets operate 24/7 unlike traditional markets'],\n      youtubeId: 'PHe0bXAIuk0',\n      youtubeTitle: 'Financial Markets Explained'\n    }, {\n      id: 3,\n      title: 'Understanding Market Participants',\n      duration: '7 min',\n      type: 'text',\n      overview: `Financial markets are made up of various participants, each playing a different role.\n\nRetail Traders are individuals like you trading with their own money. While retail traders make up a small percentage of total volume, there are millions worldwide.\n\nInstitutional Traders include banks, hedge funds, and investment firms. They move large amounts of money and can influence market direction.\n\nMarket Makers provide liquidity by always being ready to buy or sell. Central Banks control monetary policy and can dramatically impact currency values.\n\nUnderstanding who else is in the market helps you make better trading decisions.`,\n      keyTakeaways: ['Retail traders are individuals trading their own money', 'Institutional traders move large volumes and can impact prices', 'Market makers provide liquidity and profit from spreads', 'Central banks influence markets through monetary policy']\n    }, {\n      id: 4,\n      title: 'How Prices Move',\n      duration: '5 min',\n      type: 'video',\n      overview: `Price movement in financial markets is driven by supply and demand.\n\nWhen more people want to buy than sell (high demand), prices go up. When more people want to sell than buy (high supply), prices go down.\n\nWhat drives supply and demand is more complex: economic data, news events, and market sentiment all play a role. As a trader, your job is to analyze these factors and predict price direction.`,\n      keyTakeaways: ['Prices move based on supply and demand', 'More buyers than sellers = price goes up', 'More sellers than buyers = price goes down', 'News and economic data drive supply/demand changes'],\n      youtubeId: 'p7HKvqRI_Bo',\n      youtubeTitle: 'Supply and Demand Basics'\n    }, {\n      id: 5,\n      title: 'Course Quiz: Trading Basics',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your understanding of trading fundamentals.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What is the primary goal of trading?',\n        options: ['To hold assets forever', 'To profit from price movements', 'To collect dividends only', 'To avoid all risk'],\n        correctIndex: 1,\n        explanation: 'Trading aims to profit by buying assets at one price and selling at another.'\n      }, {\n        question: 'Which is the largest financial market in the world?',\n        options: ['Stock Market', 'Forex Market', 'Cryptocurrency Market', 'Commodities Market'],\n        correctIndex: 1,\n        explanation: 'The Forex market trades over $6 trillion daily.'\n      }, {\n        question: 'What happens to price when there are more buyers than sellers?',\n        options: ['Price goes down', 'Price stays the same', 'Price goes up', 'Market closes'],\n        correctIndex: 2,\n        explanation: 'When demand exceeds supply, prices rise.'\n      }, {\n        question: 'Who are retail traders?',\n        options: ['Banks and hedge funds', 'Individual traders using their own money', 'Central banks', 'Market makers only'],\n        correctIndex: 1,\n        explanation: 'Retail traders are individuals who trade with their own personal capital.'\n      }, {\n        question: 'What role do market makers play?',\n        options: ['They set interest rates', 'They provide liquidity by always being ready to buy/sell', 'They only trade stocks', 'They control currency values'],\n        correctIndex: 1,\n        explanation: 'Market makers ensure there\\'s always someone to trade with.'\n      }]\n    }]\n  }, {\n    id: 'chart-basics',\n    title: 'Chart Reading Basics',\n    description: 'Understanding candlesticks and patterns',\n    category: 'beginner',\n    lessons: [{\n      id: 1,\n      title: 'Introduction to Charts',\n      duration: '6 min',\n      type: 'video',\n      overview: 'Charts are visual representations of price movement over time. There are three main types: Line, Bar, and Candlestick charts. Learning to read charts is essential for technical analysis.',\n      keyTakeaways: ['Charts visualize price movement over time', 'Candlestick charts are most popular', 'Chart reading is essential for technical analysis'],\n      youtubeId: 'hU9BkqD3F6U',\n      youtubeTitle: 'Introduction to Trading Charts'\n    }, {\n      id: 2,\n      title: 'Candlestick Anatomy',\n      duration: '7 min',\n      type: 'video',\n      overview: 'A candlestick shows Open, High, Low, and Close. Green means bullish, red means bearish. Wicks show the extreme prices reached.',\n      keyTakeaways: ['Each candle shows OHLC data', 'Green = bullish, Red = bearish', 'Wicks show extreme prices'],\n      youtubeId: 'C3KRwfj9F8Q',\n      youtubeTitle: 'Candlestick Charts Explained'\n    }, {\n      id: 3,\n      title: 'Common Candlestick Patterns',\n      duration: '8 min',\n      type: 'video',\n      overview: 'Key patterns include Doji (indecision), Hammer (reversal), and Engulfing (momentum shift). Always confirm patterns with other analysis.',\n      keyTakeaways: ['Doji shows indecision', 'Hammer signals reversals', 'Engulfing shows momentum shifts'],\n      youtubeId: 'q8MNYg-Y1G8',\n      youtubeTitle: 'Top Candlestick Patterns'\n    }, {\n      id: 4,\n      title: 'Timeframes Explained',\n      duration: '8 min',\n      type: 'text',\n      overview: 'Scalpers use 1-5 minute charts. Day traders use 15min-1hour. Swing traders use 4hour-daily. Multi-timeframe analysis combines different views.',\n      keyTakeaways: ['Scalpers: 1-5min charts', 'Day traders: 15min-1hour', 'Swing traders: 4hour-daily']\n    }, {\n      id: 5,\n      title: 'Reading Price Action',\n      duration: '6 min',\n      type: 'video',\n      overview: 'Price action is pure price movement without indicators. Uptrend = higher highs and lows. Downtrend = lower highs and lows.',\n      keyTakeaways: ['Uptrend = higher highs and lows', 'Downtrend = lower highs and lows', 'Key levels act as support/resistance'],\n      youtubeId: 'gvAJ92Zt9fY',\n      youtubeTitle: 'Price Action Basics'\n    }, {\n      id: 6,\n      title: 'Chart Patterns Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your chart reading knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What does a green candlestick indicate?',\n        options: ['Price went down', 'Price went up (bullish)', 'No price change', 'Market is closed'],\n        correctIndex: 1,\n        explanation: 'Green means the close was higher than open.'\n      }, {\n        question: 'What does OHLC stand for?',\n        options: ['Only High Low Close', 'Open High Low Close', 'Open Hour Low Count', 'Option Hedge Long Call'],\n        correctIndex: 1,\n        explanation: 'OHLC = Open, High, Low, Close.'\n      }, {\n        question: 'What does a Doji indicate?',\n        options: ['Strong buying', 'Strong selling', 'Market indecision', 'Market closure'],\n        correctIndex: 2,\n        explanation: 'Doji shows indecision between buyers and sellers.'\n      }, {\n        question: 'What timeframe would a swing trader use?',\n        options: ['1-minute', '4-hour to daily', '1-second', 'Yearly'],\n        correctIndex: 1,\n        explanation: 'Swing traders use 4-hour to daily charts.'\n      }, {\n        question: 'An uptrend is characterized by:',\n        options: ['Lower highs and lows', 'Higher highs and lows', 'Flat movement', 'Random spikes'],\n        correctIndex: 1,\n        explanation: 'Uptrend = consistently higher highs and lows.'\n      }]\n    }]\n  }, {\n    id: 'risk-management',\n    title: 'Risk Management 101',\n    description: 'Protect your capital effectively',\n    category: 'beginner',\n    lessons: [{\n      id: 1,\n      title: 'Why Risk Management Matters',\n      duration: '5 min',\n      type: 'video',\n      overview: 'Risk management is the most important skill. Even pros lose many trades - what matters is managing those losses. Never risk more than 1-2% per trade.',\n      keyTakeaways: ['Risk management > strategy', 'Pros lose many trades too', 'Never risk more than 1-2%'],\n      youtubeId: 'wxZ26IOv1-8',\n      youtubeTitle: 'Risk Management Basics'\n    }, {\n      id: 2,\n      title: 'Position Sizing',\n      duration: '6 min',\n      type: 'video',\n      overview: 'Position sizing determines how much you invest per trade. Calculate based on your risk amount and stop loss distance.',\n      keyTakeaways: ['Position size controls dollar risk', 'Calculate based on stop loss', 'Keep risk consistent'],\n      youtubeId: 'dLvAq5YlPCo',\n      youtubeTitle: 'Position Sizing Explained'\n    }, {\n      id: 3,\n      title: 'Stop Losses and Take Profits',\n      duration: '7 min',\n      type: 'video',\n      overview: 'Stop loss limits your loss. Take profit locks gains. Aim for 1:2 risk-reward ratio minimum.',\n      keyTakeaways: ['Always use stop loss', 'Take profits lock gains', 'Aim for 1:2 risk-reward'],\n      youtubeId: 'FqF9Q9p1Yvg',\n      youtubeTitle: 'Stop Loss and Take Profit'\n    }, {\n      id: 4,\n      title: 'The 1% Rule',\n      duration: '7 min',\n      type: 'text',\n      overview: 'Never risk more than 1% per trade. With $10,000 and 1% risk, max loss per trade = $100. This protects you through losing streaks.',\n      keyTakeaways: ['1% max risk per trade', '10 losses at 1% = ~10% drawdown', 'Capital preservation is key']\n    }, {\n      id: 5,\n      title: 'Risk Management Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your risk management knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What is the recommended max risk per trade?',\n        options: ['5-10%', '1-2%', '25%', '50%'],\n        correctIndex: 1,\n        explanation: 'Professionals recommend 1-2% max risk.'\n      }, {\n        question: 'What is a stop loss?',\n        options: ['A profit target', 'An order that closes at predetermined loss', 'An indicator', 'A chart type'],\n        correctIndex: 1,\n        explanation: 'Stop loss closes your position to limit loss.'\n      }, {\n        question: 'With 1:2 risk-reward, what win rate breaks even?',\n        options: ['50%', '75%', '33%', '90%'],\n        correctIndex: 2,\n        explanation: '1 win (+$2) vs 2 losses (-$2) = break even at 33%.'\n      }, {\n        question: 'If account is $5,000 with 1% rule, max risk per trade?',\n        options: ['$500', '$50', '$100', '$250'],\n        correctIndex: 1,\n        explanation: '1% of $5,000 = $50.'\n      }, {\n        question: 'Why is position sizing important?',\n        options: ['Makes you rich fast', 'Keeps dollar risk consistent', 'Eliminates losses', 'Guarantees profits'],\n        correctIndex: 1,\n        explanation: 'Position sizing ensures consistent risk per trade.'\n      }]\n    }]\n  }, {\n    id: 'trading-psychology',\n    title: 'Trading Psychology',\n    description: 'Master your emotions',\n    category: 'beginner',\n    lessons: [{\n      id: 1,\n      title: 'The Trader\\'s Mindset',\n      duration: '6 min',\n      type: 'video',\n      overview: 'Trading is 80% psychology, 20% strategy. Think in probabilities, accept that losses are normal.',\n      keyTakeaways: ['80% psychology, 20% strategy', 'Think in probabilities', 'Losses are normal'],\n      youtubeId: '8yVuew50N8g',\n      youtubeTitle: 'Trading Mindset Basics'\n    }, {\n      id: 2,\n      title: 'Fear and Greed',\n      duration: '5 min',\n      type: 'video',\n      overview: 'Fear causes early exits. Greed causes overtrading. Focus on process, not money.',\n      keyTakeaways: ['Fear = early exits', 'Greed = overtrading', 'Focus on process'],\n      youtubeId: 'Eb1_BIZXmkA',\n      youtubeTitle: 'Fear and Greed in Trading'\n    }, {\n      id: 3,\n      title: 'Dealing with Losses',\n      duration: '8 min',\n      type: 'text',\n      overview: 'Losses are normal - pros lose 40-50% of trades. Never revenge trade. Take breaks and keep a journal.',\n      keyTakeaways: ['Pros lose 40-50%', 'Never revenge trade', 'Keep a trading journal']\n    }, {\n      id: 4,\n      title: 'Building Discipline',\n      duration: '6 min',\n      type: 'video',\n      overview: 'Create a detailed trading plan. Follow it without exceptions. Start with small positions.',\n      keyTakeaways: ['Create detailed plan', 'Follow without exceptions', 'Start small'],\n      youtubeId: 'YWgOJLCGEL4',\n      youtubeTitle: 'Building Trading Discipline'\n    }, {\n      id: 5,\n      title: 'Psychology Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your psychology knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What % of trading is psychology?',\n        options: ['20%', '50%', '80%', '10%'],\n        correctIndex: 2,\n        explanation: 'Trading is 80% psychology.'\n      }, {\n        question: 'What does fear cause traders to do?',\n        options: ['Hold longer', 'Exit early', 'Take more risks', 'Trade more'],\n        correctIndex: 1,\n        explanation: 'Fear causes premature exits.'\n      }, {\n        question: 'What is revenge trading?',\n        options: ['Trading against someone', 'Taking trades after loss to recover', 'A strategy', 'Trading during specific hours'],\n        correctIndex: 1,\n        explanation: 'Revenge trading is emotionally trying to recover losses.'\n      }, {\n        question: 'How should you respond to a loss?',\n        options: ['Trade immediately', 'Double position', 'Take a break and review', 'Quit forever'],\n        correctIndex: 2,\n        explanation: 'Take breaks for emotional reset.'\n      }, {\n        question: 'Why is a trading plan important?',\n        options: ['Guarantees profits', 'Provides rules when emotions run high', 'Eliminates losses', 'Required by law'],\n        correctIndex: 1,\n        explanation: 'Plans provide structure during emotional moments.'\n      }]\n    }]\n  }, {\n    id: 'forex-basics',\n    title: 'Forex Fundamentals',\n    description: 'Currency pairs and market structure',\n    category: 'beginner',\n    lessons: [{\n      id: 1,\n      title: 'What is Forex?',\n      duration: '5 min',\n      type: 'video',\n      overview: 'Forex is the largest market with $6+ trillion daily volume. It operates 24/5 and currencies trade in pairs.',\n      keyTakeaways: ['$6+ trillion daily', '24 hours, 5 days', 'Currencies trade in pairs'],\n      youtubeId: 'aJ8FVhNkqws',\n      youtubeTitle: 'What is Forex Trading?'\n    }, {\n      id: 2,\n      title: 'Currency Pairs Explained',\n      duration: '6 min',\n      type: 'video',\n      overview: 'Majors include USD (tightest spreads). Minors don\\'t include USD. Exotics have wider spreads.',\n      keyTakeaways: ['Majors = most liquid', 'EUR/USD most traded', 'Beginners: stick to majors'],\n      youtubeId: '4g7c4E8vU2c',\n      youtubeTitle: 'Currency Pairs Explained'\n    }, {\n      id: 3,\n      title: 'Pips, Lots, and Leverage',\n      duration: '7 min',\n      type: 'video',\n      overview: 'Pip = smallest price move. Standard lot = 100,000 units. Leverage amplifies gains AND losses.',\n      keyTakeaways: ['Pip = smallest move', 'Standard lot = 100k units', 'Leverage = double-edged sword'],\n      youtubeId: 'TF9zMvJ6x3E',\n      youtubeTitle: 'Pips, Lots and Leverage'\n    }, {\n      id: 4,\n      title: 'What Moves Currency Prices',\n      duration: '10 min',\n      type: 'text',\n      overview: 'Interest rates are primary driver. Economic data, political events, and market sentiment also matter.',\n      keyTakeaways: ['Interest rates = main driver', 'Economic data creates volatility', 'Political events matter']\n    }, {\n      id: 5,\n      title: 'Forex Trading Sessions',\n      duration: '5 min',\n      type: 'video',\n      overview: 'Sydney is quietest. London has highest volume. London/New York overlap is best for trading.',\n      keyTakeaways: ['London = highest volume', 'Sydney = quietest', 'London/NY overlap = best'],\n      youtubeId: 'W_r8pS2uQ48',\n      youtubeTitle: 'Forex Trading Sessions'\n    }, {\n      id: 6,\n      title: 'Forex Fundamentals Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your Forex knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'Daily Forex trading volume?',\n        options: ['$1 million', '$1 billion', 'Over $6 trillion', '$100 billion'],\n        correctIndex: 2,\n        explanation: 'Over $6 trillion daily.'\n      }, {\n        question: 'What is a pip in EUR/USD?',\n        options: ['0.01', '0.001', '0.0001', '1.0'],\n        correctIndex: 2,\n        explanation: 'One pip = 0.0001 for most pairs.'\n      }, {\n        question: 'What does 100:1 leverage mean?',\n        options: ['Need $100', '$1 controls $100', '100x profits only', 'Can only lose $1'],\n        correctIndex: 1,\n        explanation: '$1 controls $100 of currency.'\n      }, {\n        question: 'Which session has highest volume?',\n        options: ['Sydney', 'Tokyo', 'London', 'Weekend'],\n        correctIndex: 2,\n        explanation: 'London has highest volume.'\n      }, {\n        question: 'What happens when country raises rates?',\n        options: ['Currency weakens', 'Currency strengthens', 'No effect', 'Trading stops'],\n        correctIndex: 1,\n        explanation: 'Higher rates attract investment, strengthening currency.'\n      }]\n    }]\n  }];\n\n  // ==============================================================================\n  // INTERMEDIATE COURSES - PREMIUM ACCESS (FULL CONTENT)\n  // ==============================================================================\n\n  const INTERMEDIATE_COURSES = [{\n    id: 'technical-analysis',\n    title: 'Technical Analysis',\n    description: 'Master advanced chart patterns and indicators',\n    category: 'intermediate',\n    lessons: [{\n      id: 1,\n      title: 'Technical Analysis Foundations',\n      duration: '8 min',\n      type: 'video',\n      overview: `Technical analysis is the study of price action and market behavior to forecast future price movements. Unlike fundamental analysis, which looks at economic data, technical analysis focuses purely on charts and patterns.\n\nThe core principle is that price discounts everything - all known information is already reflected in the current price. Technical analysts believe that history tends to repeat itself, and patterns that worked before will work again.\n\nKey tools include trend analysis, support/resistance levels, chart patterns, and technical indicators. Mastering these tools gives you an edge in timing your entries and exits.`,\n      keyTakeaways: ['Technical analysis studies price action to forecast movements', 'Price discounts all known information', 'History tends to repeat - patterns recur', 'Key tools: trends, levels, patterns, indicators'],\n      youtubeId: '08R_TJhAOGo',\n      youtubeTitle: 'Technical Analysis Explained'\n    }, {\n      id: 2,\n      title: 'Market Structure Analysis',\n      duration: '10 min',\n      type: 'video',\n      overview: `Market structure refers to the pattern of higher highs/lows (uptrend) or lower highs/lows (downtrend). Understanding structure helps you trade with the trend.\n\nA Break of Structure (BOS) occurs when price breaks the most recent swing point, confirming trend continuation. A Change of Character (ChoCH) signals potential trend reversal when price fails to make new extremes.\n\nTrading with structure means buying in uptrends when price pulls back to support, and selling in downtrends when price rallies to resistance.`,\n      keyTakeaways: ['Uptrend = higher highs and higher lows', 'Downtrend = lower highs and lower lows', 'BOS confirms trend continuation', 'ChoCH signals potential reversal'],\n      youtubeId: 'xE1F0R6SBco',\n      youtubeTitle: 'Market Structure Basics'\n    }, {\n      id: 3,\n      title: 'Trend Lines and Channels',\n      duration: '8 min',\n      type: 'video',\n      overview: `Trend lines connect swing lows in uptrends or swing highs in downtrends, providing dynamic support and resistance.\n\nChannels are formed by drawing parallel lines above and below price action. Price often bounces between channel boundaries, creating trading opportunities.\n\nValid trend lines need at least 3 touches. The more touches, the more significant the level. Breaks of established trend lines often signal trend changes.`,\n      keyTakeaways: ['Trend lines provide dynamic support/resistance', 'Channels show price boundaries', 'Valid trend lines need 3+ touches', 'Trend line breaks signal potential reversals'],\n      youtubeId: 'nq-UjJNPLYY',\n      youtubeTitle: 'Trend Lines and Channels'\n    }, {\n      id: 4,\n      title: 'Chart Patterns Deep Dive',\n      duration: '12 min',\n      type: 'video',\n      overview: `Chart patterns are formations that signal potential price movements. Continuation patterns (flags, pennants, wedges) suggest the trend will continue. Reversal patterns (head & shoulders, double tops/bottoms) signal trend changes.\n\nThe Head and Shoulders is one of the most reliable reversal patterns. It consists of three peaks with the middle peak (head) being the highest.\n\nDouble tops and bottoms form when price fails to break a level twice, suggesting a reversal is likely.`,\n      keyTakeaways: ['Continuation: flags, pennants, wedges', 'Reversal: head & shoulders, double tops/bottoms', 'Head & Shoulders = reliable reversal pattern', 'Double tops/bottoms show failed breakouts'],\n      youtubeId: 'UMdj1N0r8dM',\n      youtubeTitle: 'Chart Patterns Explained'\n    }, {\n      id: 5,\n      title: 'Volume Analysis',\n      duration: '7 min',\n      type: 'text',\n      overview: `Volume confirms price movements. High volume during breakouts suggests genuine moves, while low volume suggests potential false breaks.\n\nVolume should increase in the direction of the trend. In uptrends, volume should be higher on up days. In downtrends, volume should be higher on down days.\n\nVolume divergence (price making new highs while volume decreases) often precedes reversals. Always use volume to validate your technical analysis.`,\n      keyTakeaways: ['Volume confirms price movements', 'High volume breakouts = genuine moves', 'Volume should increase with trend', 'Volume divergence precedes reversals']\n    }, {\n      id: 6,\n      title: 'Technical Analysis Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your technical analysis knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What does technical analysis focus on?',\n        options: ['Economic data', 'Company earnings', 'Price action and charts', 'News events'],\n        correctIndex: 2,\n        explanation: 'Technical analysis studies price action and chart patterns.'\n      }, {\n        question: 'What does a Break of Structure (BOS) indicate?',\n        options: ['Trend reversal', 'Trend continuation', 'Market close', 'No trading'],\n        correctIndex: 1,\n        explanation: 'BOS confirms the current trend is continuing.'\n      }, {\n        question: 'How many touches make a valid trend line?',\n        options: ['1', '2', '3 or more', '10+'],\n        correctIndex: 2,\n        explanation: 'Valid trend lines need at least 3 touches.'\n      }, {\n        question: 'What does the Head and Shoulders pattern signal?',\n        options: ['Trend continuation', 'Potential reversal', 'Market opening', 'No change'],\n        correctIndex: 1,\n        explanation: 'Head & Shoulders is a reversal pattern.'\n      }, {\n        question: 'What does high volume during breakouts suggest?',\n        options: ['False breakout', 'Genuine move', 'Market manipulation', 'No significance'],\n        correctIndex: 1,\n        explanation: 'High volume confirms breakout validity.'\n      }]\n    }]\n  }, {\n    id: 'support-resistance',\n    title: 'Support & Resistance',\n    description: 'Identify key price levels',\n    category: 'intermediate',\n    lessons: [{\n      id: 1,\n      title: 'Understanding S/R Levels',\n      duration: '7 min',\n      type: 'video',\n      overview: `Support is a price level where buying pressure exceeds selling pressure, causing price to bounce. Resistance is where selling pressure exceeds buying, causing price to reverse down.\n\nThese levels form because traders have memory - they remember where price previously reversed. Multiple bounces from a level make it more significant.\n\nSupport becomes resistance when broken, and vice versa. This \"role reversal\" is one of the most reliable concepts in trading.`,\n      keyTakeaways: ['Support = buying pressure > selling pressure', 'Resistance = selling pressure > buying pressure', 'More bounces = stronger level', 'Broken support becomes resistance (and vice versa)'],\n      youtubeId: 'Bj4GXfrxces',\n      youtubeTitle: 'Support and Resistance Basics'\n    }, {\n      id: 2,\n      title: 'Identifying Key Levels',\n      duration: '8 min',\n      type: 'video',\n      overview: `Key levels are identified by looking for areas where price has repeatedly reversed or paused. Focus on recent and significant swing points.\n\nPsychological levels (round numbers like 1.2000, 1.2500) often act as support/resistance because traders place orders at these levels.\n\nHistorical levels from higher timeframes are more significant than lower timeframe levels. Always analyze multiple timeframes for confluence.`,\n      keyTakeaways: ['Look for repeated reversals and pauses', 'Round numbers are psychological levels', 'Higher timeframe levels are more significant', 'Multi-timeframe analysis improves accuracy'],\n      youtubeId: 'TWFcK9KQE-o',\n      youtubeTitle: 'Finding Key Levels'\n    }, {\n      id: 3,\n      title: 'Trading S/R Bounces',\n      duration: '9 min',\n      type: 'video',\n      overview: `Trading bounces involves entering when price approaches a key level and shows rejection. Wait for confirmation - don't just buy because price reaches support.\n\nConfirmation signals include: rejection candles (pin bars, engulfing), divergence on indicators, or break of minor resistance on lower timeframes.\n\nAlways set your stop loss beyond the S/R level with some buffer. Take profit at the next significant level or use risk-reward targets.`,\n      keyTakeaways: ['Wait for rejection confirmation at levels', 'Use candlestick patterns for entry signals', 'Stop loss beyond the level with buffer', 'Target the next significant level'],\n      youtubeId: 'i6PQoH_M2nE',\n      youtubeTitle: 'Trading S/R Bounces'\n    }, {\n      id: 4,\n      title: 'Breakout Trading from S/R',\n      duration: '8 min',\n      type: 'text',\n      overview: `Breakouts occur when price decisively moves through a support or resistance level. True breakouts are often accompanied by increased volume and momentum.\n\nFalse breakouts are common - price briefly breaks a level then reverses back. To avoid false breaks, wait for a close beyond the level, preferably on a higher timeframe.\n\nAfter a breakout, price often retests the broken level before continuing. This retest offers a lower-risk entry opportunity.`,\n      keyTakeaways: ['True breakouts have volume and momentum', 'Wait for close beyond level to confirm', 'False breakouts are common - be patient', 'Retest entries offer lower risk']\n    }, {\n      id: 5,\n      title: 'S/R Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your support and resistance knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What is support?',\n        options: ['Where selling exceeds buying', 'Where buying exceeds selling', 'Market close', 'Trading session'],\n        correctIndex: 1,\n        explanation: 'Support is where buying pressure causes bounces.'\n      }, {\n        question: 'What happens when support is broken?',\n        options: ['It disappears', 'It becomes resistance', 'Nothing changes', 'Market closes'],\n        correctIndex: 1,\n        explanation: 'Broken support becomes resistance (role reversal).'\n      }, {\n        question: 'Why are round numbers significant?',\n        options: ['Computer preference', 'Psychological levels where orders cluster', 'Random coincidence', 'No significance'],\n        correctIndex: 1,\n        explanation: 'Traders place orders at round numbers.'\n      }, {\n        question: 'What confirms a breakout?',\n        options: ['Low volume', 'Increased volume and momentum', 'Market news', 'Time of day'],\n        correctIndex: 1,\n        explanation: 'True breakouts have volume and momentum.'\n      }, {\n        question: 'What is a retest?',\n        options: ['A failed trade', 'Price returning to broken level', 'Market closure', 'Trading strategy'],\n        correctIndex: 1,\n        explanation: 'Retests offer low-risk entry after breakouts.'\n      }]\n    }]\n  }, {\n    id: 'fibonacci',\n    title: 'Fibonacci Trading',\n    description: 'Use mathematical ratios for trading',\n    category: 'intermediate',\n    lessons: [{\n      id: 1,\n      title: 'Fibonacci Basics',\n      duration: '7 min',\n      type: 'video',\n      overview: `Fibonacci ratios are derived from the Fibonacci sequence (1, 1, 2, 3, 5, 8, 13...). Key ratios used in trading are 23.6%, 38.2%, 50%, 61.8%, and 78.6%.\n\nThese ratios appear throughout nature and financial markets. Traders use them to identify potential reversal points during retracements.\n\nThe 61.8% level (golden ratio) is considered the most significant. Price often reverses at these mathematical levels with uncanny accuracy.`,\n      keyTakeaways: ['Key ratios: 23.6%, 38.2%, 50%, 61.8%, 78.6%', 'Derived from Fibonacci sequence', '61.8% (golden ratio) is most significant', 'Ratios identify potential reversal points'],\n      youtubeId: 'VhNnkSccCMM',\n      youtubeTitle: 'Fibonacci Basics'\n    }, {\n      id: 2,\n      title: 'Fibonacci Retracements',\n      duration: '9 min',\n      type: 'video',\n      overview: `Fibonacci retracements measure how far price has pulled back from a swing. In uptrends, draw from swing low to swing high. In downtrends, draw from swing high to swing low.\n\nThe tool shows potential support levels where price might bounce and continue the trend. Most significant bounces occur at 38.2%, 50%, and 61.8%.\n\nUse multiple swing points to find confluent levels - when multiple Fibonacci levels align, the zone becomes more significant.`,\n      keyTakeaways: ['Measure pullback depth with retracements', 'Uptrend: draw low to high', '38.2%, 50%, 61.8% are key levels', 'Confluence increases significance'],\n      youtubeId: 'aSB7-FBU7_8',\n      youtubeTitle: 'Fibonacci Retracements'\n    }, {\n      id: 3,\n      title: 'Fibonacci Extensions',\n      duration: '8 min',\n      type: 'video',\n      overview: `Fibonacci extensions project where price might reach after a retracement. Key extension levels are 127.2%, 161.8%, and 261.8%.\n\nExtensions help set profit targets. If price bounces from a 61.8% retracement, it often extends to 127.2% or 161.8% of the original move.\n\nDraw extensions using three points: the swing start, swing end, and retracement low/high. This projects future targets.`,\n      keyTakeaways: ['Extensions project price targets', 'Key levels: 127.2%, 161.8%, 261.8%', 'Use for take profit placement', 'Requires three-point drawing method'],\n      youtubeId: 'uGZ_-E8Ykik',\n      youtubeTitle: 'Fibonacci Extensions'\n    }, {\n      id: 4,\n      title: 'Fibonacci Confluence',\n      duration: '8 min',\n      type: 'text',\n      overview: `Fibonacci confluence occurs when multiple Fibonacci levels from different swings align at similar prices. These zones are highly significant.\n\nCombine Fibonacci with other technical tools: S/R levels, trend lines, and moving averages. When multiple tools align, the probability of reversal increases.\n\nLook for \"kill zones\" where Fibonacci levels cluster. These areas often produce the best trading setups with higher win rates.`,\n      keyTakeaways: ['Confluence = multiple levels aligning', 'Combine with S/R and trend lines', 'Kill zones are high-probability areas', 'More confluence = higher probability']\n    }, {\n      id: 5,\n      title: 'Fibonacci Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your Fibonacci knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What is the \"golden ratio\"?',\n        options: ['23.6%', '38.2%', '61.8%', '78.6%'],\n        correctIndex: 2,\n        explanation: '61.8% is the golden ratio.'\n      }, {\n        question: 'How do you draw uptrend retracements?',\n        options: ['High to low', 'Low to high', 'Random points', 'Horizontal only'],\n        correctIndex: 1,\n        explanation: 'Uptrend retracements go from swing low to swing high.'\n      }, {\n        question: 'What do Fibonacci extensions show?',\n        options: ['Entry points', 'Stop losses', 'Price targets', 'Volume'],\n        correctIndex: 2,\n        explanation: 'Extensions project where price might reach.'\n      }, {\n        question: 'What is Fibonacci confluence?',\n        options: ['Single level', 'Multiple levels aligning', 'Market close', 'Trading session'],\n        correctIndex: 1,\n        explanation: 'Confluence is when multiple levels align.'\n      }, {\n        question: 'Which levels are most significant for retracements?',\n        options: ['10%, 20%, 30%', '38.2%, 50%, 61.8%', '90%, 95%, 100%', 'Random levels'],\n        correctIndex: 1,\n        explanation: '38.2%, 50%, and 61.8% are key retracement levels.'\n      }]\n    }]\n  }, {\n    id: 'moving-averages',\n    title: 'Moving Averages Mastery',\n    description: 'Dynamic support, resistance, and signals',\n    category: 'intermediate',\n    lessons: [{\n      id: 1,\n      title: 'Types of Moving Averages',\n      duration: '7 min',\n      type: 'video',\n      overview: `Moving averages smooth price data to identify trend direction. Simple Moving Average (SMA) gives equal weight to all periods. Exponential Moving Average (EMA) weights recent prices more heavily.\n\nCommon periods: 20 for short-term, 50 for medium-term, 200 for long-term trend. The 200 MA is considered the most important for overall trend direction.\n\nEMA reacts faster to price changes, while SMA is smoother. Most traders prefer EMA for shorter timeframes and SMA for longer ones.`,\n      keyTakeaways: ['SMA = equal weight, EMA = recent weight', 'Common periods: 20, 50, 200', '200 MA = most important for trend', 'EMA faster, SMA smoother'],\n      youtubeId: 'gf9t3a3Q0xM',\n      youtubeTitle: 'Moving Averages Explained'\n    }, {\n      id: 2,\n      title: 'MA as Dynamic S/R',\n      duration: '8 min',\n      type: 'video',\n      overview: `Moving averages act as dynamic support and resistance. In uptrends, price often bounces off the MA from above. In downtrends, price rejects from the MA from below.\n\nThe 20 EMA is popular for aggressive entries in strong trends. The 50 EMA works well for swing trading. The 200 MA defines the overall trend.\n\nWhen price is above the 200 MA, look for long trades. When below, focus on shorts. This simple rule keeps you trading with the trend.`,\n      keyTakeaways: ['MAs provide dynamic support/resistance', '20 EMA = aggressive trend entries', '200 MA defines overall trend', 'Above 200 MA = look long, below = look short'],\n      youtubeId: 'D8QKPwnvmL4',\n      youtubeTitle: 'MA Dynamic Support/Resistance'\n    }, {\n      id: 3,\n      title: 'MA Crossover Strategies',\n      duration: '9 min',\n      type: 'video',\n      overview: `MA crossovers generate signals when a faster MA crosses a slower MA. Golden Cross: 50 MA crosses above 200 MA (bullish). Death Cross: 50 MA crosses below 200 MA (bearish).\n\nShorter-period crossovers (9/21 EMA) generate more signals but more false ones. Longer-period crossovers are more reliable but lag more.\n\nCrossovers work best in trending markets. In ranging markets, they produce many false signals. Always confirm with other tools.`,\n      keyTakeaways: ['Golden Cross = bullish (50 above 200)', 'Death Cross = bearish (50 below 200)', 'Shorter periods = more signals, more false', 'Best in trending markets'],\n      youtubeId: 'PgQM-CUJzWg',\n      youtubeTitle: 'MA Crossover Strategies'\n    }, {\n      id: 4,\n      title: 'Multiple MA Systems',\n      duration: '8 min',\n      type: 'text',\n      overview: `Many traders use multiple MAs together. A common setup is 9, 21, and 50 EMAs. When stacked in order (9 > 21 > 50), the trend is strong bullish. Reversed order (9 < 21 < 50) = strong bearish.\n\nMA ribbon systems use many MAs (8, 13, 21, 34, 55). When ribbons expand, trend is accelerating. When they contract, momentum is slowing.\n\nUse MA slope to gauge trend strength. Steep slopes indicate strong momentum; flat MAs suggest consolidation.`,\n      keyTakeaways: ['Multiple MAs show trend strength', 'Stacked MAs confirm trend direction', 'Expanding ribbon = accelerating trend', 'MA slope indicates momentum']\n    }, {\n      id: 5,\n      title: 'Moving Averages Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your moving average knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What is the difference between SMA and EMA?',\n        options: ['No difference', 'EMA weights recent prices more', 'SMA is faster', 'EMA uses volume'],\n        correctIndex: 1,\n        explanation: 'EMA gives more weight to recent prices.'\n      }, {\n        question: 'What is a Golden Cross?',\n        options: ['50 MA below 200 MA', '50 MA above 200 MA', 'Price above MA', 'Price below MA'],\n        correctIndex: 1,\n        explanation: 'Golden Cross = 50 MA crosses above 200 MA.'\n      }, {\n        question: 'Which MA is most important for trend?',\n        options: ['9 MA', '20 MA', '50 MA', '200 MA'],\n        correctIndex: 3,\n        explanation: '200 MA defines overall trend.'\n      }, {\n        question: 'How do MAs act as support?',\n        options: ['Fixed levels', 'Dynamic levels that move with price', 'News events', 'Volume spikes'],\n        correctIndex: 1,\n        explanation: 'MAs provide dynamic, moving support/resistance.'\n      }, {\n        question: 'When do MA crossovers work best?',\n        options: ['Ranging markets', 'Trending markets', 'News events', 'All times equally'],\n        correctIndex: 1,\n        explanation: 'Crossovers perform best in trending conditions.'\n      }]\n    }]\n  }, {\n    id: 'rsi-macd',\n    title: 'RSI & MACD Strategies',\n    description: 'Master momentum indicators',\n    category: 'intermediate',\n    lessons: [{\n      id: 1,\n      title: 'RSI Fundamentals',\n      duration: '8 min',\n      type: 'video',\n      overview: `RSI (Relative Strength Index) measures momentum on a 0-100 scale. Above 70 = overbought, below 30 = oversold. Standard setting is 14 periods.\n\nOverbought doesn't mean \"sell now\" - in strong trends, RSI can stay overbought for extended periods. Use overbought/oversold as alerts, not automatic signals.\n\nRSI divergence is powerful: when price makes new highs but RSI makes lower highs, momentum is weakening. This often precedes reversals.`,\n      keyTakeaways: ['RSI range: 0-100, standard 14 periods', 'Above 70 = overbought, below 30 = oversold', 'Overbought can persist in strong trends', 'RSI divergence precedes reversals'],\n      youtubeId: 'fSorNdF6MYg',\n      youtubeTitle: 'RSI Indicator Explained'\n    }, {\n      id: 2,\n      title: 'RSI Trading Strategies',\n      duration: '9 min',\n      type: 'video',\n      overview: `The 50 level is key for RSI. In uptrends, RSI tends to stay above 50. In downtrends, it stays below. Use 50 as a trend filter.\n\nRSI range trading: buy when RSI drops to 30 in uptrends, sell when it rises to 70 in downtrends. This catches pullbacks within trends.\n\nRSI breakouts: draw trend lines on RSI itself. RSI breaking its trend line often precedes price breaking its trend line.`,\n      keyTakeaways: ['50 level = trend filter', 'Buy at 30 in uptrends, sell at 70 in downtrends', 'RSI trend lines predict price trend lines', 'Combine with price action for confirmation'],\n      youtubeId: 'wQ-i84kLHBM',\n      youtubeTitle: 'RSI Trading Strategies'\n    }, {\n      id: 3,\n      title: 'MACD Fundamentals',\n      duration: '8 min',\n      type: 'video',\n      overview: `MACD (Moving Average Convergence Divergence) shows momentum and trend direction. It consists of MACD line, Signal line, and Histogram.\n\nStandard settings: 12, 26, 9. MACD line = 12 EMA - 26 EMA. Signal line = 9 EMA of MACD. Histogram = MACD - Signal.\n\nMACD crossing above signal line = bullish. Crossing below = bearish. Zero line crossings indicate trend direction changes.`,\n      keyTakeaways: ['MACD = momentum + trend indicator', 'Standard: 12, 26, 9', 'MACD above signal = bullish', 'Zero line shows trend direction'],\n      youtubeId: 'vuMjcJQ6xxM',\n      youtubeTitle: 'MACD Indicator Explained'\n    }, {\n      id: 4,\n      title: 'MACD Divergence Trading',\n      duration: '8 min',\n      type: 'text',\n      overview: `MACD divergence is one of the most reliable reversal signals. Regular divergence: price makes new extreme, MACD doesn't = potential reversal.\n\nHidden divergence suggests trend continuation. In uptrends, price makes higher low but MACD makes lower low = continuation bullish.\n\nThe histogram shows momentum. Growing histogram = increasing momentum. Shrinking histogram = momentum fading. Watch for histogram divergence too.`,\n      keyTakeaways: ['Regular divergence = reversal signal', 'Hidden divergence = continuation signal', 'Histogram shows momentum strength', 'Shrinking histogram = fading momentum']\n    }, {\n      id: 5,\n      title: 'RSI & MACD Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your RSI and MACD knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What RSI level indicates overbought?',\n        options: ['30', '50', '70', '100'],\n        correctIndex: 2,\n        explanation: 'Above 70 = overbought.'\n      }, {\n        question: 'What is RSI divergence?',\n        options: ['RSI matches price', 'RSI contradicts price', 'RSI at zero', 'RSI at 100'],\n        correctIndex: 1,\n        explanation: 'Divergence = price and RSI moving opposite.'\n      }, {\n        question: 'What are standard MACD settings?',\n        options: ['9, 21, 50', '12, 26, 9', '20, 50, 200', '5, 10, 15'],\n        correctIndex: 1,\n        explanation: 'Standard MACD: 12, 26, 9.'\n      }, {\n        question: 'What does MACD histogram show?',\n        options: ['Volume', 'Momentum strength', 'Price level', 'Time'],\n        correctIndex: 1,\n        explanation: 'Histogram shows momentum intensity.'\n      }, {\n        question: 'MACD crossing above signal line is:',\n        options: ['Bearish', 'Neutral', 'Bullish', 'Invalid'],\n        correctIndex: 2,\n        explanation: 'MACD above signal = bullish.'\n      }]\n    }]\n  }, {\n    id: 'breakout-trading',\n    title: 'Breakout Trading',\n    description: 'Catch explosive moves',\n    category: 'intermediate',\n    lessons: [{\n      id: 1,\n      title: 'Breakout Trading Basics',\n      duration: '7 min',\n      type: 'video',\n      overview: `Breakouts occur when price moves beyond established support or resistance with momentum. These moments often lead to explosive moves as orders trigger.\n\nTrue breakouts need volume confirmation. Without volume, the move lacks conviction and may fail. Look for volume 1.5-2x average.\n\nBreakouts can occur from consolidation ranges, chart patterns (triangles, rectangles), or key S/R levels. Each type has different characteristics.`,\n      keyTakeaways: ['Breakouts = price beyond S/R with momentum', 'Volume confirms breakout validity', 'Look for 1.5-2x average volume', 'Multiple breakout types exist'],\n      youtubeId: 'Pr90rZL7VF8',\n      youtubeTitle: 'Breakout Trading Basics'\n    }, {\n      id: 2,\n      title: 'Identifying Breakout Setups',\n      duration: '9 min',\n      type: 'video',\n      overview: `Best breakouts come from tight consolidations. When price compresses into narrow ranges, energy builds. The subsequent breakout is often powerful.\n\nLook for declining volume during consolidation, then expanding volume on breakout. This pattern shows accumulation before the move.\n\nHigher timeframe breakouts are more reliable. A daily breakout carries more weight than a 5-minute breakout. Always check the bigger picture.`,\n      keyTakeaways: ['Tight consolidations = powerful breakouts', 'Declining volume before, expanding on break', 'Higher timeframe breakouts more reliable', 'Check the bigger picture'],\n      youtubeId: 'Iz8IJL7rfBM',\n      youtubeTitle: 'Finding Breakout Setups'\n    }, {\n      id: 3,\n      title: 'False Breakout Recognition',\n      duration: '8 min',\n      type: 'video',\n      overview: `False breakouts are common - up to 70% of breakouts fail. Price briefly breaks a level then reverses back inside the range.\n\nSigns of false breaks: low volume, quick reversal, wicks beyond level but close inside, occurring against the larger trend.\n\nTrade false breakouts by fading them: when a breakout fails, enter in the opposite direction with stop beyond the false break high/low.`,\n      keyTakeaways: ['Up to 70% of breakouts fail', 'Low volume = likely false break', 'Wicks beyond, close inside = false', 'False breakouts can be traded'],\n      youtubeId: 'nWPjNWAc5RM',\n      youtubeTitle: 'False Breakout Trading'\n    }, {\n      id: 4,\n      title: 'Breakout Entry Techniques',\n      duration: '8 min',\n      type: 'text',\n      overview: `Three entry methods: 1) Aggressive - enter as price breaks level. 2) Moderate - wait for candle close beyond level. 3) Conservative - wait for retest of broken level.\n\nRetest entries offer better risk-reward but you may miss some breakouts that don't retest. Aggressive entries catch more moves but have more false signals.\n\nStop loss placement: beyond the breakout candle or below the last swing low for longs. Target based on measured move (range height) or next S/R level.`,\n      keyTakeaways: ['Three entries: aggressive, moderate, conservative', 'Retest offers better R:R but misses some', 'Stop beyond breakout candle', 'Target = measured move or next S/R']\n    }, {\n      id: 5,\n      title: 'Breakout Trading Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your breakout trading knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What confirms a true breakout?',\n        options: ['Low volume', 'High volume', 'News', 'Time of day'],\n        correctIndex: 1,\n        explanation: 'High volume confirms breakout validity.'\n      }, {\n        question: 'What percentage of breakouts fail?',\n        options: ['10%', '30%', 'Up to 70%', '90%'],\n        correctIndex: 2,\n        explanation: 'Up to 70% of breakouts fail.'\n      }, {\n        question: 'What indicates a false breakout?',\n        options: ['High volume', 'Close beyond level', 'Wick beyond, close inside', 'Strong momentum'],\n        correctIndex: 2,\n        explanation: 'Wicks beyond but closing inside = false break.'\n      }, {\n        question: 'What is a retest entry?',\n        options: ['Entering on first break', 'Waiting for return to broken level', 'Trading against breakout', 'Random entry'],\n        correctIndex: 1,\n        explanation: 'Retest = entering when price returns to broken level.'\n      }, {\n        question: 'Best breakouts come from:',\n        options: ['Wide ranges', 'Tight consolidations', 'Trending markets', 'News events'],\n        correctIndex: 1,\n        explanation: 'Tight consolidations produce powerful breakouts.'\n      }]\n    }]\n  }];\n\n  // ==============================================================================\n  // ADVANCED COURSES - VIP ACCESS (FULL CONTENT)\n  // ==============================================================================\n\n  const ADVANCED_COURSES = [{\n    id: 'institutional',\n    title: 'Institutional Trading',\n    description: 'Trade like banks and hedge funds',\n    category: 'advanced',\n    lessons: [{\n      id: 1,\n      title: 'How Institutions Trade',\n      duration: '10 min',\n      type: 'video',\n      overview: `Institutional traders (banks, hedge funds) don't trade like retail traders. They can't simply click buy/sell - their orders are too large. They need to accumulate and distribute positions over time without moving price against themselves.\n\nUnderstanding institutional behavior gives you an edge. They leave footprints in the market: order blocks, fair value gaps, and liquidity sweeps. Learning to read these can put you on the same side as smart money.\n\nInstitutions need liquidity to fill orders. They often manipulate price to areas where retail stops cluster, then reverse. This is why many retail traders get stopped out before the market moves in their direction.`,\n      keyTakeaways: ['Institutions can\\'t enter/exit quickly like retail', 'They accumulate/distribute over time', 'They leave footprints: order blocks, FVGs, sweeps', 'They hunt retail stop losses for liquidity'],\n      youtubeId: '5B-RpC3wbsg',\n      youtubeTitle: 'How Institutions Trade'\n    }, {\n      id: 2,\n      title: 'Order Blocks',\n      duration: '9 min',\n      type: 'video',\n      overview: `Order blocks are areas where institutions have placed significant orders. They appear as the last opposing candle before a strong move. When price returns to these areas, it often reverses.\n\nBullish order block: the last bearish candle before a strong bullish move. Bearish order block: the last bullish candle before a strong bearish move.\n\nNot all order blocks are equal. Focus on ones that broke structure, have clean moves away, and haven't been mitigated (revisited) yet.`,\n      keyTakeaways: ['Order blocks = institutional order areas', 'Last opposing candle before strong move', 'Price often reverses at order blocks', 'Unmitigated blocks are most powerful'],\n      youtubeId: 'eSFt1F3sJwU',\n      youtubeTitle: 'Order Blocks Explained'\n    }, {\n      id: 3,\n      title: 'Fair Value Gaps (FVG)',\n      duration: '8 min',\n      type: 'video',\n      overview: `Fair Value Gaps are imbalances in price where buying and selling didn't occur equally. They appear as gaps between candle wicks, showing aggressive moves.\n\nPrice tends to return to fill these gaps because they represent \"unfair\" prices - areas where orders weren't properly matched. Institutional traders often target these gaps.\n\nUse FVGs as entry zones. When price returns to fill a gap in the direction of your trade, it offers high-probability entries with tight stops.`,\n      keyTakeaways: ['FVG = imbalance between candle wicks', 'Represent aggressive, unbalanced moves', 'Price tends to return and fill gaps', 'Use as entry zones in trend direction'],\n      youtubeId: 'k7y-6xIyNYw',\n      youtubeTitle: 'Fair Value Gaps Trading'\n    }, {\n      id: 4,\n      title: 'Liquidity Concepts',\n      duration: '10 min',\n      type: 'text',\n      overview: `Liquidity is where stop losses and pending orders cluster. Common areas: above/below obvious swing points, round numbers, and trend line touches.\n\nInstitutions need liquidity to fill large orders. They often push price to these areas to trigger stops, which provides the liquidity they need, then reverse.\n\n\"Liquidity sweeps\" occur when price briefly spikes beyond a level to grab stops, then reverses. Recognizing these can help you avoid getting stopped out and potentially trade the reversal.`,\n      keyTakeaways: ['Liquidity = clustered orders (stops, pending)', 'Found at swing points, round numbers', 'Institutions sweep liquidity before reversing', 'Avoid placing stops at obvious levels']\n    }, {\n      id: 5,\n      title: 'Institutional Concepts Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your institutional trading knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'Why can\\'t institutions trade like retail?',\n        options: ['Regulations', 'Their orders are too large', 'Time restrictions', 'Technology limits'],\n        correctIndex: 1,\n        explanation: 'Large orders would move price against them.'\n      }, {\n        question: 'What is an order block?',\n        options: ['Technical indicator', 'Last opposing candle before strong move', 'News event', 'Volume spike'],\n        correctIndex: 1,\n        explanation: 'Order block = institutional order area.'\n      }, {\n        question: 'What is a Fair Value Gap?',\n        options: ['Price target', 'Imbalance between candle wicks', 'Support level', 'Moving average'],\n        correctIndex: 1,\n        explanation: 'FVG shows aggressive, imbalanced moves.'\n      }, {\n        question: 'What is a liquidity sweep?',\n        options: ['Market close', 'Spike to grab stops then reverse', 'Volume increase', 'Trend start'],\n        correctIndex: 1,\n        explanation: 'Sweeps grab liquidity before reversing.'\n      }, {\n        question: 'Where is liquidity commonly found?',\n        options: ['Random levels', 'Above/below swing points', 'Only at round numbers', 'Never at obvious levels'],\n        correctIndex: 1,\n        explanation: 'Stops cluster at obvious swing points.'\n      }]\n    }]\n  }, {\n    id: 'order-flow',\n    title: 'Order Flow Analysis',\n    description: 'Read market depth and order activity',\n    category: 'advanced',\n    lessons: [{\n      id: 1,\n      title: 'Order Flow Basics',\n      duration: '9 min',\n      type: 'video',\n      overview: `Order flow shows the actual buying and selling happening in real-time. While charts show price history, order flow shows what's driving price right now.\n\nMarket orders (immediate execution) move price. Limit orders (pending orders) provide levels where price may pause. Understanding the interaction between these reveals market intent.\n\nOrder flow analysis requires specific tools: footprint charts, depth of market (DOM), and volume profile. These show where orders are executing and where liquidity sits.`,\n      keyTakeaways: ['Order flow shows real-time buying/selling', 'Market orders move price', 'Limit orders provide support/resistance', 'Requires specialized tools: footprint, DOM'],\n      youtubeId: '4OgL_e1PpTM',\n      youtubeTitle: 'Order Flow Basics'\n    }, {\n      id: 2,\n      title: 'Volume Profile Analysis',\n      duration: '10 min',\n      type: 'video',\n      overview: `Volume Profile shows where the most trading occurred at each price level. High Volume Nodes (HVN) act as magnets and S/R. Low Volume Nodes (LVN) are areas price moves through quickly.\n\nPoint of Control (POC) is the price with most volume - the \"fair value\" for that session. Price tends to return to POC like a magnet.\n\nValue Area (VA) contains 70% of volume. Price inside VA is \"fair\" - expect ranging. Price outside VA is \"unfair\" - expect it to return or trend strongly.`,\n      keyTakeaways: ['HVN = support/resistance, magnets', 'LVN = areas of quick movement', 'POC = fair value, price magnet', 'Value Area = 70% of volume'],\n      youtubeId: 'TJxQO6ntAcs',\n      youtubeTitle: 'Volume Profile Trading'\n    }, {\n      id: 3,\n      title: 'Delta and Cumulative Delta',\n      duration: '9 min',\n      type: 'video',\n      overview: `Delta measures the difference between buying and selling volume. Positive delta = more buying. Negative delta = more selling.\n\nCumulative Delta (CD) shows the running total of delta. Rising CD with rising price confirms buyers in control. Divergence between price and CD signals potential reversal.\n\nDelta divergence is powerful: if price makes new highs but delta is lower than the previous high, buying is weakening. This often precedes pullbacks.`,\n      keyTakeaways: ['Delta = buying volume - selling volume', 'Cumulative Delta shows running total', 'Price + CD rising = buyers in control', 'Delta divergence signals reversals'],\n      youtubeId: 'Y2Dx1J6P1Pw',\n      youtubeTitle: 'Delta Analysis'\n    }, {\n      id: 4,\n      title: 'Absorption and Exhaustion',\n      duration: '9 min',\n      type: 'text',\n      overview: `Absorption occurs when large limit orders absorb market orders without price moving much. This shows institutional presence - they're accumulating without showing their hand.\n\nWatch for high volume with little price movement. This indicates strong hands absorbing selling (bullish) or buying (bearish) pressure.\n\nExhaustion occurs when aggressive buyers/sellers push price but fail to attract follow-through. Volume spikes but price quickly reverses. This signals the move is ending.`,\n      keyTakeaways: ['Absorption = orders absorbed without price move', 'Shows institutional accumulation', 'Exhaustion = volume spike with quick reversal', 'Both signal potential turning points']\n    }, {\n      id: 5,\n      title: 'Order Flow Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your order flow knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What moves price?',\n        options: ['Limit orders', 'Market orders', 'News', 'Time'],\n        correctIndex: 1,\n        explanation: 'Market orders (immediate execution) move price.'\n      }, {\n        question: 'What is Point of Control (POC)?',\n        options: ['Random level', 'Price with most volume', 'Daily high', 'Daily low'],\n        correctIndex: 1,\n        explanation: 'POC = highest volume price level.'\n      }, {\n        question: 'What does positive delta indicate?',\n        options: ['More selling', 'More buying', 'No activity', 'Market close'],\n        correctIndex: 1,\n        explanation: 'Positive delta = buying > selling.'\n      }, {\n        question: 'What is absorption?',\n        options: ['Price spike', 'Orders absorbed with little price movement', 'Volume decrease', 'Trend start'],\n        correctIndex: 1,\n        explanation: 'Absorption = high volume, little price movement.'\n      }, {\n        question: 'What does exhaustion indicate?',\n        options: ['Trend start', 'Move is ending', 'More momentum coming', 'Market open'],\n        correctIndex: 1,\n        explanation: 'Exhaustion signals the current move is ending.'\n      }]\n    }]\n  }, {\n    id: 'smart-money',\n    title: 'Smart Money Concepts',\n    description: 'Follow institutional footprints',\n    category: 'advanced',\n    lessons: [{\n      id: 1,\n      title: 'Smart Money vs Dumb Money',\n      duration: '8 min',\n      type: 'video',\n      overview: `Smart Money refers to institutional traders with information advantages and deep pockets. Dumb Money is retail traders who often trade emotionally and predictably.\n\nRetail traders tend to buy at highs and sell at lows, chase breakouts, and place stops at obvious levels. Smart money exploits these patterns.\n\nThe goal is to identify what smart money is doing and align with them. This means avoiding retail traps and recognizing accumulation/distribution phases.`,\n      keyTakeaways: ['Smart Money = institutions with advantages', 'Retail often buys highs, sells lows', 'Smart money exploits retail behavior', 'Align with smart money, avoid traps'],\n      youtubeId: 'NcC5C0Qd9kU',\n      youtubeTitle: 'Smart Money Concepts'\n    }, {\n      id: 2,\n      title: 'Accumulation and Distribution',\n      duration: '10 min',\n      type: 'video',\n      overview: `Accumulation is when smart money quietly builds positions at low prices. Price moves sideways while they absorb all selling. Then price breaks out.\n\nDistribution is the opposite - smart money sells positions at high prices. Price moves sideways while they offload, then breaks down.\n\nWyckoff methodology describes these phases. Look for: trading range after trend, tests of support/resistance, springs (false breaks), and volume patterns.`,\n      keyTakeaways: ['Accumulation = building positions at lows', 'Distribution = selling positions at highs', 'Both appear as sideways ranges', 'Wyckoff describes these phases'],\n      youtubeId: '9q-fmQ_HjK4',\n      youtubeTitle: 'Accumulation and Distribution'\n    }, {\n      id: 3,\n      title: 'Inducement and Manipulation',\n      duration: '9 min',\n      type: 'video',\n      overview: `Inducement is how smart money attracts retail orders to provide liquidity. They create obvious patterns that retail traders love to trade.\n\nCommon inducements: double bottoms/tops that fail, obvious trend lines that break, support/resistance that doesn't hold initially.\n\nThe \"stop hunt\" is manipulation where price spikes to take out stops, then reverses. This provides smart money the liquidity they need to enter large positions.`,\n      keyTakeaways: ['Inducement attracts retail orders', 'Creates patterns retail loves to trade', 'Stop hunts provide liquidity', 'Recognize inducement to avoid traps'],\n      youtubeId: 'V9j-JmMxwVQ',\n      youtubeTitle: 'Market Manipulation'\n    }, {\n      id: 4,\n      title: 'Trading with Smart Money',\n      duration: '9 min',\n      type: 'text',\n      overview: `To trade with smart money: 1) Wait for liquidity grabs (stop hunts) before entering. 2) Trade from order blocks and FVGs. 3) Enter on retests, not breakouts. 4) Avoid obvious levels for stops.\n\nThe mindset shift: instead of asking \"where should I enter?\", ask \"where will smart money enter?\". Think about liquidity and order flow.\n\nPatience is essential. Smart money setups don't appear constantly. Wait for high-probability scenarios where retail gets trapped and smart money reverses price.`,\n      keyTakeaways: ['Wait for liquidity grabs before entering', 'Trade from order blocks and FVGs', 'Enter on retests, not breakouts', 'Think \"where will smart money enter?\"']\n    }, {\n      id: 5,\n      title: 'Smart Money Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your smart money knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'Who is \"Smart Money\"?',\n        options: ['Retail traders', 'Institutional traders', 'News reporters', 'Brokers'],\n        correctIndex: 1,\n        explanation: 'Smart Money = institutions with advantages.'\n      }, {\n        question: 'What is accumulation?',\n        options: ['Selling at highs', 'Building positions at lows', 'Random trading', 'Day trading'],\n        correctIndex: 1,\n        explanation: 'Accumulation = building positions quietly.'\n      }, {\n        question: 'What is inducement?',\n        options: ['Teaching', 'Attracting retail orders for liquidity', 'Technical indicator', 'News trading'],\n        correctIndex: 1,\n        explanation: 'Inducement attracts retail to provide liquidity.'\n      }, {\n        question: 'What is a stop hunt?',\n        options: ['Searching for trades', 'Spike to take out stops then reverse', 'Volume analysis', 'Trend following'],\n        correctIndex: 1,\n        explanation: 'Stop hunts grab liquidity then reverse.'\n      }, {\n        question: 'How should you place stops?',\n        options: ['At obvious levels', 'Beyond obvious levels with buffer', 'Very tight', 'Very wide'],\n        correctIndex: 1,\n        explanation: 'Avoid obvious levels that get hunted.'\n      }]\n    }]\n  }, {\n    id: 'liquidity',\n    title: 'Liquidity Trading',\n    description: 'Understand and trade liquidity',\n    category: 'advanced',\n    lessons: [{\n      id: 1,\n      title: 'Liquidity Fundamentals',\n      duration: '9 min',\n      type: 'video',\n      overview: `Liquidity in trading terms means resting orders (stops and limits) at specific price levels. These orders are the \"fuel\" that moves markets.\n\nExternal liquidity sits above highs and below lows - where stops cluster. Internal liquidity is within price ranges - order blocks, FVGs, and imbalances.\n\nPrice is always seeking liquidity. Understanding this principle explains why price often sweeps highs/lows before reversing - it's grabbing liquidity.`,\n      keyTakeaways: ['Liquidity = resting orders at price levels', 'External: above highs, below lows', 'Internal: order blocks, FVGs', 'Price constantly seeks liquidity'],\n      youtubeId: 'mSN_FDxaZxI',\n      youtubeTitle: 'Liquidity in Trading'\n    }, {\n      id: 2,\n      title: 'Liquidity Pools',\n      duration: '8 min',\n      type: 'video',\n      overview: `Liquidity pools are areas where significant orders have accumulated. Equal highs/lows form obvious pools - everyone sees them, everyone places stops there.\n\n\"Buy-side liquidity\" sits above resistance levels (buy stops). \"Sell-side liquidity\" sits below support levels (sell stops).\n\nThe most powerful trades come after liquidity pools are swept. Once the stops are triggered, the move often reverses because the \"fuel\" has been consumed.`,\n      keyTakeaways: ['Equal highs/lows = obvious liquidity pools', 'Buy-side above resistance, sell-side below support', 'Best trades after pools are swept', 'Swept liquidity often leads to reversal'],\n      youtubeId: '3a_nTBJ-r-8',\n      youtubeTitle: 'Liquidity Pools Trading'\n    }, {\n      id: 3,\n      title: 'Trading Liquidity Sweeps',\n      duration: '10 min',\n      type: 'video',\n      overview: `A liquidity sweep occurs when price spikes beyond a level, triggers stops, then reverses. This is the \"raid\" on liquidity before smart money makes their move.\n\nTo trade sweeps: 1) Identify liquidity pools (equal highs/lows, trend lines). 2) Wait for the sweep. 3) Look for reversal confirmation (order block, FVG, divergence). 4) Enter with stop beyond the sweep.\n\nRisk warning: not all sweeps reverse. Sometimes price continues after grabbing liquidity. Always wait for confirmation and manage risk properly.`,\n      keyTakeaways: ['Sweep = spike beyond level, triggers stops, reverses', 'Identify pools, wait for sweep, confirm, enter', 'Stop goes beyond the sweep high/low', 'Not all sweeps reverse - always confirm'],\n      youtubeId: 'gL-vgQPmj4E',\n      youtubeTitle: 'Trading Liquidity Sweeps'\n    }, {\n      id: 4,\n      title: 'Advanced Liquidity Concepts',\n      duration: '9 min',\n      type: 'text',\n      overview: `Liquidity engineering is how smart money creates and sweeps liquidity. They may push price to form equal highs, then return later to sweep them.\n\nPremium and Discount zones: price above equilibrium (50% of range) is premium - look to sell. Below equilibrium is discount - look to buy. Combine with liquidity for high-probability trades.\n\nOptimal Trade Entry (OTE): the zone between 61.8% and 78.6% Fibonacci retracement where liquidity often sits. This is where smart money tends to enter after sweeps.`,\n      keyTakeaways: ['Smart money engineers liquidity targets', 'Premium = above 50%, look to sell', 'Discount = below 50%, look to buy', 'OTE zone: 61.8-78.6% retracement']\n    }, {\n      id: 5,\n      title: 'Liquidity Trading Quiz',\n      duration: '5 min',\n      type: 'quiz',\n      overview: 'Test your liquidity trading knowledge.',\n      keyTakeaways: [],\n      quizQuestions: [{\n        question: 'What is liquidity in trading?',\n        options: ['Cash on hand', 'Resting orders at price levels', 'Market cap', 'Daily volume'],\n        correctIndex: 1,\n        explanation: 'Liquidity = stops and limits at levels.'\n      }, {\n        question: 'Where is buy-side liquidity?',\n        options: ['Below support', 'Above resistance', 'At round numbers only', 'Random locations'],\n        correctIndex: 1,\n        explanation: 'Buy-side sits above resistance (buy stops).'\n      }, {\n        question: 'What happens after a sweep?',\n        options: ['Always continues', 'Often reverses', 'Nothing', 'Market closes'],\n        correctIndex: 1,\n        explanation: 'Swept liquidity often leads to reversal.'\n      }, {\n        question: 'What is the OTE zone?',\n        options: ['0-23.6% Fib', '61.8-78.6% Fib', '100% Fib', 'Random zone'],\n        correctIndex: 1,\n        explanation: 'OTE = 61.8-78.6% retracement zone.'\n      }, {\n        question: 'What is a premium zone?',\n        options: ['Below 50% of range', 'Above 50% of range', 'Random area', 'News event area'],\n        correctIndex: 1,\n        explanation: 'Premium = above equilibrium, look to sell.'\n      }]\n    }]\n  }];\n\n  // ==============================================================================\n  // COURSE PREVIEWS (for locked display)\n  // ==============================================================================\n\n  const INTERMEDIATE_COURSE_PREVIEWS = INTERMEDIATE_COURSES.map(c => ({\n    id: c.id,\n    title: c.title,\n    preview: c.description\n  }));\n  const ADVANCED_COURSE_PREVIEWS = ADVANCED_COURSES.map(c => ({\n    id: c.id,\n    title: c.title,\n    preview: c.description\n  }));\n\n  // ==============================================================================\n  // HELPER FUNCTIONS\n  // ==============================================================================\n\n  function getCourseContent(courseId)